# OpenAI-compatible gateway or vLLM endpoint.
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
DEFAULT_MODEL=

# Remote MCP registry. Requests can reference only these IDs; arbitrary URLs are rejected.
# Example:
# MCP_SERVERS_JSON=[{"id":"internal-tools","url":"https://mcp.example.com/mcp","tokenEnv":"INTERNAL_MCP_TOKEN","enabled":true}]
MCP_SERVERS_JSON=[]
# INTERNAL_MCP_TOKEN=

# Optional observability endpoint. Runtime instrumentation is a governed later phase.
OPENLIT_ENDPOINT=

# Optional memory provider. Runtime memory is a governed later phase.
MEM0_API_KEY=
